{
  "name": "orm-preflight",
  "mcpName": "io.github.sikandar100/orm-preflight",
  "version": "1.0.2",
  "description": "Preflight safety checks for TypeORM migrations: catch data loss and locking before you merge.",
  "keywords": [
    "typeorm",
    "migration",
    "migrations",
    "postgres",
    "postgresql",
    "mysql",
    "lint",
    "linter",
    "zero-downtime",
    "nestjs",
    "database",
    "schema"
  ],
  "homepage": "https://sikandar100.github.io/orm-preflight/",
  "bugs": {
    "url": "https://github.com/sikandar100/orm-preflight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sikandar100/orm-preflight.git"
  },
  "license": "MIT",
  "author": "Sikandar Waheed",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "orm-preflight": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "schema.json",
    "action.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:pack": "node scripts/check-pack.mjs",
    "check:publint": "publint --strict",
    "check:attw": "attw --pack .",
    "check:secrets": "secretlint \"**/*\"",
    "smoke": "node scripts/smoke-tarball.mjs",
    "changeset": "changeset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "version-packages": "changeset version && node scripts/sync-action-version.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "jiti": "2.7.0",
    "libpg-query": "18.1.5",
    "picocolors": "1.1.1",
    "tinyglobby": "0.2.17"
  },
  "peerDependencies": {
    "node-sql-parser": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "node-sql-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/types": "7.29.8",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "lefthook": "2.1.14",
    "node-sql-parser": "5.4.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "secretlint": "13.0.6",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
