  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "orm-preflight",
      "version": "1.1.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
